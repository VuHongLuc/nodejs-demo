// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(uuid())
  name  String
  age   Int
  posts Post[]
  @@index([age]) // Danh index de tang toc do truy van theo age
  @@fulltext([name], map: "fulltext_name_index") // Tang toc tim kiem: LIKE %abc%
  @@map("user")
}

model Post {
  id      String @id @default(uuid())
  title   String
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id])
  @@index([userId]) // Danh index de tang toc do truy van theo userId (tim kiem tat ca cac bai post cua 1 user)
  @@fulltext([title], map: "fulltext_title_index") // Tang toc tim kiem: LIKE %abc%
  @@map("post")
}
